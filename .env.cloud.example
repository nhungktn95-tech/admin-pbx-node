# .env cho triển khai cloud (docker-compose.yml + docker-compose.cloud.yml). Xem docs/trien-khai-cloud.md.
# Sao chép thành .env rồi sửa MỌI giá trị có (*). KHÔNG commit .env.

# ---------------- Mạng ----------------
# (*) IP PUBLIC của máy chủ (softphone, trình duyệt, nhà mạng thấy IP này). Lấy: curl -4 ifconfig.me
HOST_IP=203.0.113.10
# (*) IP card mạng của máy chủ (cloud thường là IP nội bộ VPC, khác IP public). Lấy: ip -4 addr / hostname -I
#     Máy chủ có IP public gắn thẳng trên card mạng thì đặt = HOST_IP.
PRIVATE_IP=10.0.1.5
# (*) IP nội bộ/VPN mà AMI 5038 + ARI 8088 nghe — PBX Gateway vào qua IP này. KHÔNG dùng IP public / 0.0.0.0.
#     Thường = PRIVATE_IP (Gateway cùng VPC) hoặc IP WireGuard của máy chủ.
ADMIN_BIND=10.0.1.5
# (*) Tên miền trỏ (bản ghi A) về HOST_IP. Trình duyệt đăng nhập: wss://<DOMAIN>/ws
DOMAIN=pbx.example.gov.vn
# (*) Email nhận thông báo hết hạn chứng chỉ Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.gov.vn

# Dải cổng âm thanh (RTP). Mỗi kênh dùng 2 cổng (RTP + RTCP), cuộc gọi 2 bên = 2 kênh = 4 cổng.
# 10000-20000 ≈ 5000 kênh ≈ 2500 cuộc gọi 2 bên — dư so với CPU một máy, không còn là giới hạn. Firewall mở đúng dải này.
RTP_START=10000
RTP_END=20000

# ---------------- Database (chỉ trong máy chủ) ----------------
DB_HOST=db
DB_PORT=5432
DB_NAME=asterisk
DB_USER=asterisk
# (*) Mật khẩu mạnh
DB_PASSWORD=doi_mat_khau_db_manh

TZ=Asia/Ho_Chi_Minh
RECORD_CALLS=yes

# ---------------- PBX Gateway ----------------
# (*) IP mà Gateway dùng khi nối vào ADMIN_BIND (IP nội bộ/VPN của máy Gateway)
GATEWAY_IP=10.0.1.20
# (*) Cloud không có NAT Docker cho AMI: đặt = IP Gateway (bỏ dải 172.16.0.0/12 của lab)
AMI_PERMIT_EXTRA=10.0.1.20/255.255.255.255
# (*) Mật khẩu mạnh (AMI có quyền config: sửa được mọi file cấu hình Asterisk)
AMI_USER=gateway
AMI_SECRET=doi_mat_khau_ami_manh
ARI_USER=gateway
ARI_PASSWORD=doi_mat_khau_ari_manh
# Không còn dùng từ G2 (giữ để db/init/03-gateway-user.sh không báo lỗi)
GW_DB_USER=pbx_gateway
GW_DB_PASSWORD=doi_mat_khau_db_gateway_manh

# ---------------- TURN (chỉ khi bật: --profile turn) ----------------
TURN_USER=pbxturn
TURN_PASSWORD=doi_mat_khau_turn_manh
TURN_MIN_PORT=49160
TURN_MAX_PORT=49360

# ---------------- Chịu tải / vận hành (docs/chiu-tai.md) ----------------
# Mức log màn hình của Asterisk (docker logs): 3 = từng bước dialplan (gỡ lỗi). Tải cao / môi trường thật: 0 hoặc 1.
AST_VERBOSE=1
# Log Asterisk (/var/log/asterisk) xoay vòng mỗi ngày, giữ bấy nhiêu ngày.
LOG_KEEP_DAYS=14
# Cảnh báo (docker logs, dòng "[don-dep] CẢNH BÁO") khi ổ chứa ghi âm/log/astdb dùng từ ngưỡng này (%).
DISK_WARN_PERCENT=85
# Thư mục ghi âm trên máy chủ (nên là ổ riêng). Để trống = volume Docker "recordings".
RECORDINGS_PATH=/data/recordings
# Xóa file ghi âm cũ hơn N ngày. Để trống = KHÔNG BAO GIỜ xóa (mặc định). Chỉ đặt khi đã có quy định thời hạn lưu.
RECORDING_KEEP_DAYS=

# ---------------- Sao lưu (scripts/backup.sh, docs/sao-luu.md) ----------------
# Thư mục đích (nên là ổ khác ổ chạy Docker, và đẩy thêm ra máy khác). Bản sao lưu chứa mật khẩu (.env) -> giới hạn quyền.
BACKUP_DIR=/backup/pbx
# Giữ bản sao lưu bấy nhiêu ngày
BACKUP_KEEP_DAYS=14
# yes: đồng bộ tăng dần thư mục ghi âm vào BACKUP_DIR/recordings (cần rsync, chạy bằng root nếu ghi âm nằm trong volume Docker)
BACKUP_RECORDINGS=no

# ---------------- Giao lịch sử sang Gateway (cdr-shipper, docs/cdr-shipper.md) ----------------
# Bật khi Gateway đã có API nhận lịch sử: bỏ dấu # ở dòng COMPOSE_PROFILES.
#COMPOSE_PROFILES=shipper
GATEWAY_CDR_URL=https://gateway.example/api/clusters/lab-02/cdr
CLUSTER_ID=lab-02
# (*) Khóa API Gateway cấp riêng cho cụm này
CDR_API_KEY=doi_khoa_api_cdr
# (*) User DB chỉ đọc cdr, chỉ dùng trong cụm (db/init/04-cdr-shipper-user.sh)
CDR_SHIPPER_DB_USER=cdr_shipper
CDR_SHIPPER_DB_PASSWORD=doi_mat_khau_cdr_shipper
# Lần đầu bật: all = gửi toàn bộ lịch sử cũ; now = chỉ từ lúc bật
CDR_SHIP_START=all

# ---------------- IVR (docs/ivr.md) ----------------
# PIN để ghi lời chào IVR qua điện thoại (gọi *46<số IVR>). Để trống = tắt tính năng ghi lời chào.
IVR_RECORD_PIN=

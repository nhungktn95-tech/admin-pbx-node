; ============================================================
; HTTP server của Asterisk
;   8088 (http)  : ARI - chỉ cho Gateway
;   8089 (https) : WSS /ws - Softphone SDK trong trình duyệt đăng nhập qua đây
; Địa chỉ nghe (entrypoint.sh, mặc định 0.0.0.0 cho lab/Docker bridge):
;   AST_ADMIN_BIND: 8088 (ARI). Cloud: IP nội bộ/VPN để Gateway vào, KHÔNG ra Internet.
;   AST_WSS_BIND  : 8089 (WSS). Cloud: 127.0.0.1 - chỉ nginx gọi vào, nginx chỉ chuyển tiếp /ws (ARI không lộ qua 8089).
; ============================================================
[general]
enabled = yes
bindaddr = ${AST_ADMIN_BIND}
bindport = 8088
servername = pbx-node

tlsenable = yes
tlsbindaddr = ${AST_WSS_BIND}:8089
tlscertfile = /etc/asterisk/keys/asterisk.crt
tlsprivatekey = /etc/asterisk/keys/asterisk.key

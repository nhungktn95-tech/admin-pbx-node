; ============================================================
; AMI (Asterisk Manager Interface) - cổng 5038/tcp
; Chỉ PBX Gateway được vào. AMI KHÔNG mã hóa: tuyệt đối không mở ra Internet,
; chỉ dùng trong mạng nội bộ/VPN và firewall chỉ cho IP Gateway.
; ============================================================
[general]
enabled = yes
port = 5038
; Lab/Docker bridge: 0.0.0.0 (cổng map ra ngoài theo ADMIN_BIND). Cloud (network_mode host): IP nội bộ/VPN.
bindaddr = ${AST_ADMIN_BIND}
displayconnects = no
timestampevents = yes

; Tài khoản dành riêng cho PBX Gateway
[${AMI_USER}]
secret = ${AMI_SECRET}
deny = 0.0.0.0/0.0.0.0
permit = ${GATEWAY_IP}/255.255.255.255
permit = 127.0.0.1/255.255.255.255
; Lab: Gateway chạy cùng máy với Docker thì kết nối đi qua mạng nội bộ Docker (172.16-31.x.x).
; Môi trường thật: đặt AMI_PERMIT_EXTRA = IP Gateway để bỏ dải này.
permit = ${AMI_PERMIT_EXTRA}
; Quyền: đọc trạng thái + gửi lệnh gọi/chuyển máy + đọc/sửa file cấu hình (config: Gateway quản lý group trong queues.conf
; bằng GetConfig/UpdateConfig). config sửa được MỌI file trong /etc/asterisk → AMI chỉ mở cho IP Gateway, mật khẩu mạnh.
read = system,call,agent,user,dtmf,reporting,cdr,config
write = system,call,agent,user,originate,reporting,config
writetimeout = 5000
; Bỏ sự kiện RTCPSent/RTCPReceived (lớp "reporting"): Asterisk gửi vài giây một lần cho MỖI kênh đang có âm thanh
; -> 200 cuộc gọi = hàng trăm sự kiện/giây, Gateway đọc không kịp quá writetimeout thì bị ngắt AMI và mất sự kiện Cdr.
; Gateway không dùng các sự kiện này. Cần chất lượng âm thanh thì dùng lệnh "pjsip show channelstats" khi cần.
; Dấu ! = loại trừ; chỉ có bộ lọc loại trừ thì mọi sự kiện khác vẫn được gửi như cũ.
eventfilter = !Event: RTCP

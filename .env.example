# Sao chép file này thành .env rồi sửa các giá trị có đánh dấu (*)

# (*) IP của máy chạy pbx-node trong mạng LAN (softphone, trình duyệt, Gateway kết nối vào IP này)
# Windows: ipconfig  |  macOS: ipconfig getifaddr en0  |  Linux: hostname -I
HOST_IP=192.168.1.10

# Realtime DB (user chính, Asterisk dùng)
DB_HOST=db
DB_PORT=5432
DB_NAME=asterisk
DB_USER=asterisk
DB_PASSWORD=asterisk_lab_123

# Dải cổng âm thanh (RTP). Mỗi kênh dùng 2 cổng (RTP + RTCP), cuộc gọi 2 bên = 2 kênh = 4 cổng.
# Lab dùng 100 cổng = tối đa ~50 kênh ≈ 25 cuộc gọi 2 bên (gọi group ringall còn ít hơn) — chỉ đủ thử chức năng.
# Docker bridge map từng cổng nên KHÔNG nên mở rộng nhiều ở lab; thử tải/chạy thật dùng docker-compose.cloud.yml.
RTP_START=10000
RTP_END=10099

TZ=Asia/Ho_Chi_Minh

# Ghi âm mọi cuộc gọi đã nối máy (yes/no). File .wav ~1 MB/phút, KHÔNG tự xóa.
RECORD_CALLS=yes

# ---------------- Kết nối cho PBX Gateway ----------------
# (*) IP máy chạy PBX Gateway. AMI chỉ cho IP này (và dải AMI_PERMIT_EXTRA) đăng nhập.
GATEWAY_IP=192.168.1.20
# Lab: Gateway chạy cùng máy Docker → giữ dải mạng Docker. Môi trường thật: đặt = IP Gateway/255.255.255.255
AMI_PERMIT_EXTRA=172.16.0.0/255.240.0.0
# Địa chỉ mở cổng 5432/5038/8088. Môi trường thật nên đặt IP card mạng nội bộ/VPN thay vì 0.0.0.0
ADMIN_BIND=0.0.0.0

# (*) Tài khoản AMI cho Gateway
AMI_USER=gateway
AMI_SECRET=doi_mat_khau_ami
# (*) Tài khoản ARI cho Gateway (giai đoạn 2 mới dùng)
ARI_USER=gateway
ARI_PASSWORD=doi_mat_khau_ari
# (*) User DB riêng cho Gateway (chỉ đủ quyền ghi ps_*/queues, đọc cdr)
GW_DB_USER=pbx_gateway
GW_DB_PASSWORD=doi_mat_khau_db_gateway

# ---------------- Chịu tải / vận hành (docs/chiu-tai.md) ----------------
# Mức log màn hình của Asterisk (docker logs): 3 = từng bước dialplan (gỡ lỗi). Tải cao / môi trường thật: 0 hoặc 1.
AST_VERBOSE=3
# Log Asterisk (/var/log/asterisk) xoay vòng mỗi ngày, giữ bấy nhiêu ngày.
LOG_KEEP_DAYS=14
# Cảnh báo (docker logs, dòng "[don-dep] CẢNH BÁO") khi ổ chứa ghi âm/log/astdb dùng từ ngưỡng này (%).
DISK_WARN_PERCENT=85
# Thư mục ghi âm trên máy chủ (nên là ổ riêng). Để trống = volume Docker "recordings".
RECORDINGS_PATH=
# Xóa file ghi âm cũ hơn N ngày. Để trống = KHÔNG BAO GIỜ xóa (mặc định). Chỉ đặt khi đã có quy định thời hạn lưu.
RECORDING_KEEP_DAYS=
